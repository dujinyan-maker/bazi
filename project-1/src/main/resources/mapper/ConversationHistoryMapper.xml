<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.example.project1.mapper.ConversationHistoryMapper">

    <resultMap id="BaseResultMap" type="org.example.project1.pojo.domain.ConversationHistory">
        <id column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="conversation_id" property="conversationId"/>
        <result column="role" property="role"/>
        <result column="content" property="content"/>
        <result column="created_time" property="createdTime"/>
    </resultMap>

    <select id="selectByConversationId" resultMap="BaseResultMap">
        SELECT * FROM conversation_history
        WHERE conversation_id = #{conversationId}
        ORDER BY created_time ASC
        <if test="limit != null and limit > 0">
            LIMIT #{limit}
        </if>
    </select>

    <select id="selectByUserId" resultMap="BaseResultMap">
        SELECT * FROM conversation_history
        WHERE user_id = #{userId}
        <if test="conversationId != null and conversationId != ''">
            AND conversation_id = #{conversationId}
        </if>
        ORDER BY created_time ASC
        <if test="limit != null and limit > 0">
            LIMIT #{limit}
        </if>
    </select>

    <insert id="insertConversation" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO conversation_history (
            user_id, conversation_id, role, content, created_time
        ) VALUES (
            #{userId}, #{conversationId}, #{role}, #{content}, NOW()
        )
    </insert>

    <delete id="deleteByConversationId">
        DELETE FROM conversation_history WHERE conversation_id = #{conversationId}
    </delete>

</mapper>

